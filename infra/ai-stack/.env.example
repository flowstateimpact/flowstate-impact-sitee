# ---- domain / auth ----------------------------------------------------------
DOMAIN=example.com
COMFY_HOST=10.0.0.20             # private IP of the GPU box
COMFY_BASIC_AUTH_HASH=           # caddy hash-password --plaintext '...'

# ---- gateway ----------------------------------------------------------------
LITELLM_MASTER_KEY=sk-change-me          # admin key; never give to clients
LITELLM_SALT_KEY=change-me-32-chars
POSTGRES_PASSWORD=change-me

# ---- provider keys (Commercial Terms / pay-as-you-go accounts only) ---------
ANTHROPIC_API_KEY=               # console.anthropic.com  (NOT a Max plan OAuth token)
MOONSHOT_API_KEY=                # platform.moonshot.ai
FIREWORKS_API_KEY=               # fireworks.ai (fastest Kimi K3)
OPENROUTER_API_KEY=              # fallback + Hermes 4 hosted
HF_TOKEN=                        # HuggingFace Inference Providers + model downloads

# ---- LibreChat --------------------------------------------------------------
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CREDS_KEY=change-me-64-hex
CREDS_IV=change-me-32-hex
LIBRECHAT_GATEWAY_KEY=           # a LiteLLM virtual key for the UI (create via tenants/create-tenant.sh)

# ---- storage ----------------------------------------------------------------
MINIO_ROOT_USER=flowstate
MINIO_ROOT_PASSWORD=change-me

# ---- tenants (one virtual key per client, generated by create-tenant.sh) ---
TENANT_EXAMPLE_KEY=
